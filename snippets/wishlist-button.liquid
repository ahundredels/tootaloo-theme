{% comment %}
  Renders a heart/wishlist toggle button for a product.

  Usage:
    {% render 'wishlist-button', product: product %}

  Drop this into:
    - snippets/card-product.liquid  (on the product card, e.g. inside .card__media)
    - sections/main-product.liquid  (near the Add to Cart button)

  Requires assets/wishlist.js and assets/wishlist.css to be loaded on every
  page (add both to layout/theme.liquid, see comments at bottom of this file).
{% endcomment %}

<button
  type="button"
  class="wishlist-button"
  data-wishlist-toggle
  data-product-id="{{ product.id }}"
  data-variant-id="{{ product.selected_or_first_available_variant.id }}"
  data-product-handle="{{ product.handle }}"
  aria-pressed="false"
  aria-label="Add to wishlist"
>
  <svg class="wishlist-button__icon wishlist-button__icon--outline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <path d="M12 21s-7.5-4.7-10.1-9.3C.3 8.6 1.6 5 5 4.1c2-.5 4 .3 5 2 .1.1.2.1.3 0 1-1.7 3-2.5 5-2 3.4.9 4.7 4.5 3.1 7.6C19.5 16.3 12 21 12 21z"/>
  </svg>
  <svg class="wishlist-button__icon wishlist-button__icon--filled" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M12 20.7 3.9 12.6a5.4 5.4 0 0 1 0-7.7 5.4 5.4 0 0 1 7.6 0l.5.5.5-.5a5.4 5.4 0 0 1 7.6 0 5.4 5.4 0 0 1 0 7.7z"/>
  </svg>
</button>

{% comment %}
  ── One-time setup ──
  1. In layout/theme.liquid, right before </head> or </body>, add:
       {{ 'wishlist.css' | asset_url | stylesheet_tag }}
       <script src="{{ 'wishlist.js' | asset_url }}" defer></script>

  2. If you want wishlist to sync across devices for logged-in customers,
     add this right before wishlist.js loads (also in theme.liquid):
       {% if customer %}
         <script>window.__WISHLIST_CUSTOMER_ID__ = "{{ customer.id }}";</script>
       {% endif %}
     (Syncing requires a small backend — an app proxy route at /apps/wishlist/*
     backed by a customer metafield, e.g. via a lightweight Cloudflare Worker
     or Shopify Function. Without it, wishlist still works great per-browser
     via localStorage — most stores ship with just that.)
{% endcomment %}
