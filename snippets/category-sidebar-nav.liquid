{% comment %}
  Left-side category / designer nav, driven by a real Shopify navigation menu
  so it stays merchant-editable (Online Store > Navigation, handle "shop-sidebar").
  Supports one level of nesting.

  >=990px: a persistent bordered column beside the product grid.
  750-989px: a static block above the grid.
  <750px: a slide-in sheet opened by the "Designers A-Z" button in the mobile
  PLP bar (snippets/tt-plp-bar.liquid), which toggles the checkbox
  #CategoryToggle-<handle> below.

  Usage: {% render 'category-sidebar-nav', menu: 'shop-sidebar' %}
{% endcomment %}

{%- liquid
  assign menu_handle = menu | default: 'shop-sidebar'
  assign nav_menu = linklists[menu_handle]
-%}

<nav class="category-sidebar" aria-label="Shop categories">
  {%- if nav_menu -%}
    <input type="checkbox" id="CategoryToggle-{{ menu_handle }}" class="category-sidebar__toggle-input" aria-hidden="true">
    <label for="CategoryToggle-{{ menu_handle }}" class="category-sidebar__backdrop" aria-hidden="true"></label>

    <div class="category-sidebar__panel">
      <div class="category-sidebar__panel-head">
        <span class="category-sidebar__panel-title">Designers A-Z</span>
        <label for="CategoryToggle-{{ menu_handle }}" class="category-sidebar__panel-close" aria-label="Close">
          {{- 'icon-close.svg' | inline_asset_content -}}
        </label>
      </div>

      <ul class="category-sidebar__list">
        {%- for link in nav_menu.links -%}
          <li class="category-sidebar__item">
            <a href="{{ link.url }}" class="category-sidebar__link{% if link.active %} is-active{% endif %}">
              {{ link.title }}
            </a>
            {%- if link.links.size > 0 -%}
              <ul class="category-sidebar__sublist">
                {%- for sublink in link.links -%}
                  <li>
                    <a href="{{ sublink.url }}" class="category-sidebar__sublink{% if sublink.active %} is-active{% endif %}">
                      {{ sublink.title }}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- else -%}
    <p class="category-sidebar__placeholder">
      Create a menu with handle "{{ menu_handle }}" in Online Store &gt; Navigation to populate this sidebar.
    </p>
  {%- endif -%}
</nav>

{% stylesheet %}
  .category-sidebar {
    width: 100%;
    max-width: var(--tt-sidebar-width);
  }

  .category-sidebar__toggle-input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .category-sidebar__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .category-sidebar__item {
    margin-bottom: var(--tt-space-5);
  }

  .category-sidebar__link {
    display: block;
    text-decoration: none;
    color: rgb(var(--color-foreground));
    font-family: var(--tt-font-grotesk);
    font-size: var(--tt-fs-2xs);
    font-weight: var(--tt-fw-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tt-tracking-widest);
    padding: calc(var(--tt-space-1) / 2) 0;
  }

  .category-sidebar__sublist {
    list-style: none;
    margin: var(--tt-space-2) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--tt-space-1);
  }

  .category-sidebar__sublink {
    display: block;
    text-decoration: none;
    color: rgba(var(--color-foreground), 0.65);
    font-size: var(--tt-fs-sm);
    letter-spacing: var(--tt-tracking-normal);
    padding: calc(var(--tt-space-1) / 2) 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .category-sidebar__sublink { transition: color var(--tt-dur) var(--tt-ease); }
  }

  .category-sidebar__sublink:hover { color: rgb(var(--color-foreground)); }

  .category-sidebar__link.is-active,
  .category-sidebar__sublink.is-active {
    color: rgb(var(--color-foreground));
    text-decoration: underline;
    text-underline-offset: 0.3rem;
  }

  .category-sidebar__placeholder {
    color: rgba(var(--color-foreground), 0.6);
    font-size: var(--tt-fs-sm);
  }

  /* ── Mobile: slide-in sheet (< 750px, matches Dawn's facet-drawer breakpoint) ── */
  @media screen and (max-width: 749px) {
    .category-sidebar { max-width: none; }

    .category-sidebar__backdrop {
      position: fixed;
      inset: 0;
      z-index: 90;
      background: rgba(0, 0, 0, 0.4);
      opacity: 0;
      pointer-events: none;
    }

    .category-sidebar__panel {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      z-index: 91;
      width: min(84vw, 32rem);
      background: rgb(var(--color-background));
      border-right: var(--tt-border);
      padding: var(--tt-space-5);
      overflow-y: auto;
      transform: translateX(-100%);
    }

    @media (prefers-reduced-motion: no-preference) {
      .category-sidebar__backdrop { transition: opacity 200ms ease; }
      .category-sidebar__panel { transition: transform 280ms ease-out; }
    }

    .category-sidebar__toggle-input:checked ~ .category-sidebar__backdrop {
      opacity: 1;
      pointer-events: auto;
    }

    .category-sidebar__toggle-input:checked ~ .category-sidebar__panel {
      transform: none;
    }

    .category-sidebar__panel-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: var(--tt-space-5);
    }

    .category-sidebar__panel-title {
      font-family: var(--tt-font-grotesk);
      font-size: var(--tt-fs-2xs);
      font-weight: var(--tt-fw-semibold);
      text-transform: uppercase;
      letter-spacing: var(--tt-tracking-widest);
    }

    .category-sidebar__panel-close {
      display: inline-flex;
      padding: var(--tt-space-2);
      margin: calc(-1 * var(--tt-space-2));
      cursor: pointer;
    }

    .category-sidebar__panel-close .icon { width: 1.8rem; height: 1.8rem; }
  }

  /* ── Tablet + desktop: static panel, list always visible ── */
  @media screen and (min-width: 750px) {
    .category-sidebar__backdrop,
    .category-sidebar__panel-head {
      display: none;
    }

    .category-sidebar__panel {
      position: static;
      transform: none;
      width: auto;
      padding: 0;
      border: 0;
      overflow: visible;
    }
  }
{% endstylesheet %}
