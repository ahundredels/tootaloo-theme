{% comment %}
  Left-side category nav, styled after winfarlab.com / ninetwofive.online's
  browsing sidebar (Tops > T-shirts, Tank Tops... / Bottoms > Pants, Jeans...).

  Reads from a real Shopify navigation menu, so tomorrow you just build the
  menu in Online Store > Navigation and this renders it automatically —
  no code changes needed. Supports one level of nesting.

  Usage:
    {% render 'category-sidebar-nav', menu: 'shop-sidebar' %}

  Setup: create a menu in Shopify admin with handle "shop-sidebar" (or
  whatever you pass in), with top-level items like "Tops", "Bottoms",
  "Accessories", and nested links under each for subcategories.
{% endcomment %}

{%- liquid
  assign menu_handle = menu | default: 'shop-sidebar'
  assign nav_menu = linklists[menu_handle]
-%}

<nav class="category-sidebar" aria-label="Shop categories">
  {%- if nav_menu -%}
    <ul class="category-sidebar__list">
      {%- for link in nav_menu.links -%}
        <li class="category-sidebar__item">
          <a href="{{ link.url }}" class="category-sidebar__link{% if link.active %} is-active{% endif %}">
            {{ link.title }}
          </a>
          {%- if link.links.size > 0 -%}
            <ul class="category-sidebar__sublist">
              {%- for sublink in link.links -%}
                <li>
                  <a href="{{ sublink.url }}" class="category-sidebar__sublink{% if sublink.active %} is-active{% endif %}">
                    {{ sublink.title }}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- else -%}
    <p class="category-sidebar__placeholder">
      Create a menu with handle "{{ menu_handle }}" in Online Store &gt; Navigation to populate this sidebar.
    </p>
  {%- endif -%}
</nav>

{% stylesheet %}
  .category-sidebar {
    width: 100%;
    max-width: var(--tt-sidebar-width);
  }

  .category-sidebar__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .category-sidebar__item {
    margin-bottom: var(--tt-space-sm);
  }

  .category-sidebar__link {
    display: block;
    text-decoration: none;
    color: rgb(var(--color-foreground));
    font-family: var(--tt-font-grotesk);
    font-size: var(--tt-fs-2xs);
    font-weight: var(--tt-fw-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tt-tracking-widest);
    padding: 0.2rem 0;
  }

  .category-sidebar__sublist {
    list-style: none;
    margin: var(--tt-space-2xs) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .category-sidebar__sublink {
    display: block;
    text-decoration: none;
    color: rgba(var(--color-foreground), 0.65);
    font-size: var(--tt-fs-sm);
    letter-spacing: var(--tt-tracking-normal);
    padding: 0.2rem 0;
    transition: color var(--tt-dur) var(--tt-ease);
  }

  .category-sidebar__sublink:hover {
    color: rgb(var(--color-foreground));
  }

  .category-sidebar__link.is-active,
  .category-sidebar__sublink.is-active {
    color: rgb(var(--color-foreground));
    text-decoration: underline;
    text-underline-offset: 0.3rem;
  }

  .category-sidebar__placeholder {
    color: rgba(var(--color-foreground), 0.6);
    font-size: var(--tt-fs-sm);
  }
{% endstylesheet %}
