{%- comment -%}
  Tootaloo — Brand Feature. A brand given a room: name, a few words,
  one image, a way in, and optionally a short row of its pieces.

  This is the homepage module. The full brand page (metaobject-backed) is
  a separate template. Nothing is baked in — leave it blank and it stays
  hidden on the live site.
{%- endcomment -%}

{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'tt-modules.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign coll = section.settings.collection
  assign has_content = false
  if section.settings.brand_name != blank or section.settings.image != blank or section.settings.description != blank
    assign has_content = true
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .brand-feature {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .brand-feature {
      padding-top: {{ section.settings.padding_top | times: 0.6 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round }}px;
    }
  }
{%- endstyle -%}

<div class="brand-feature brand-feature--{{ section.settings.layout }} brand-feature--span-{{ section.settings.span }} color-{{ section.settings.color_scheme }} gradient">
  <div class="brand-feature__inner {% if section.settings.span == 'full' %}tt-fullbleed{% else %}page-width{% endif %}">
    {%- if has_content -%}
      <div class="brand-feature__lede">
        {%- if section.settings.image != blank -%}
          {%- assign link = section.settings.link_url | default: coll.url -%}
          <a class="brand-feature__media tt-media" data-ratio="{{ section.settings.image_ratio }}"{% if link %} href="{{ link }}"{% endif %}>
            {%- if section.settings.image_mobile != blank -%}
              <img class="brand-feature__img brand-feature__img--mobile" src="{{ section.settings.image_mobile | image_url: width: 1000 }}" srcset="{{ section.settings.image_mobile | image_url: width: 600 }} 600w, {{ section.settings.image_mobile | image_url: width: 1000 }} 1000w" sizes="100vw" width="{{ section.settings.image_mobile.width }}" height="{{ section.settings.image_mobile.height }}" alt="{{ section.settings.image_mobile.alt | escape }}" loading="lazy">
            {%- endif -%}
            <img class="brand-feature__img brand-feature__img--desktop" src="{{ section.settings.image | image_url: width: 1800 }}" srcset="{{ section.settings.image | image_url: width: 800 }} 800w, {{ section.settings.image | image_url: width: 1200 }} 1200w, {{ section.settings.image | image_url: width: 1800 }} 1800w" sizes="(min-width: 990px) 50vw, 100vw" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}" alt="{{ section.settings.image.alt | escape }}" loading="lazy">
          </a>
        {%- endif -%}

        <div class="brand-feature__info">
          {%- if section.settings.eyebrow != blank -%}
            <p class="brand-feature__eyebrow tt-utility">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.brand_name != blank -%}
            <h2 class="brand-feature__name tt-drop-title">{{ section.settings.brand_name | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.description != blank -%}
            <div class="brand-feature__text rte">{{ section.settings.description }}</div>
          {%- endif -%}
          {%- assign link = section.settings.link_url | default: coll.url -%}
          {%- if link and section.settings.link_label != blank -%}
            <a class="brand-feature__link tt-nav" href="{{ link }}">
              {{- section.settings.link_label | escape -}}
              <span aria-hidden="true">&rarr;</span>
            </a>
          {%- endif -%}
        </div>
      </div>

      {%- if coll != blank and coll.products_count > 0 -%}
        <ul class="brand-feature__row" role="list">
          {%- for product in coll.products limit: section.settings.product_limit -%}
            <li class="brand-feature__row-item">
              {%- render 'card-product',
                card_product: product,
                media_aspect_ratio: 'portrait',
                show_vendor: false,
                lazy_load: true,
                skip_styles: true,
                section_id: section.id
              -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    {%- elsif request.design_mode -%}
      <p class="tt-collection-row__placeholder">Add a brand name, an image or a description to show this section.</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Brand Feature",
  "tag": "section",
  "class": "section section--tt-module",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label", "default": "Brand" },
    { "type": "text", "id": "brand_name", "label": "Brand name" },
    { "type": "richtext", "id": "description", "label": "Description" },
    { "type": "image_picker", "id": "image", "label": "Image (desktop)" },
    { "type": "image_picker", "id": "image_mobile", "label": "Image (mobile)" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Enter" },
    { "type": "url", "id": "link_url", "label": "Link URL", "info": "Defaults to the collection below." },
    { "type": "header", "content": "Pieces" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Optional short row of this brand’s pieces." },
    { "type": "range", "id": "product_limit", "min": 2, "max": 6, "step": 1, "default": 3, "label": "Pieces to show" },
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "image-left", "label": "Image left" },
        { "value": "image-right", "label": "Image right" },
        { "value": "image-over", "label": "Text over image" }
      ],
      "default": "image-left"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" },
        { "value": "landscape", "label": "Landscape" },
        { "value": "featured-wide", "label": "Wide" }
      ],
      "default": "landscape"
    },
    {
      "type": "select",
      "id": "span",
      "label": "Section width",
      "options": [
        { "value": "normal", "label": "Constrained" },
        { "value": "wide", "label": "Wide" },
        { "value": "full", "label": "Full bleed" }
      ],
      "default": "wide"
    },
    { "type": "header", "content": "Section" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96, "label": "Top padding" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96, "label": "Bottom padding" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [
    { "name": "Brand Feature", "settings": { "layout": "image-left", "span": "wide" } }
  ]
}
{% endschema %}
