{%- comment -%}
  Tootaloo — Editorial Image. A story image with no commerce controls:
  full bleed or constrained, cropped or left at its natural ratio, with
  optional text beside, below or laid over it. This is the block that is
  allowed to break the grid (brief §18).

  Empty image → placeholder in the theme editor, nothing on the live site.
{%- endcomment -%}

{{ 'tt-modules.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign img = section.settings.image
  assign place = section.settings.text_placement
  assign is_overlay = false
  if place contains 'overlay'
    assign is_overlay = true
  endif
  assign has_text = false
  if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank or section.settings.link_label != blank
    assign has_text = true
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .editorial-image {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .editorial-image {
      padding-top: {{ section.settings.padding_top | times: 0.6 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round }}px;
    }
  }
{%- endstyle -%}

<div class="editorial-image editorial-image--{{ place }} editorial-image--w-{{ section.settings.width }} editorial-image--scrim-{{ section.settings.scrim }} color-{{ section.settings.color_scheme }} gradient">
  <div class="editorial-image__inner {% if section.settings.width == 'full' %}tt-fullbleed{% elsif section.settings.width == 'constrained' %}page-width page-width--narrow{% else %}page-width{% endif %}">
    <figure class="editorial-image__figure">
      {%- capture media -%}
        <div class="editorial-image__media tt-media{% if section.settings.image_ratio == 'natural' %} tt-media--natural{% endif %}"{% if section.settings.image_ratio != 'natural' %} data-ratio="{{ section.settings.image_ratio }}"{% endif %}>
          {%- if img != blank -%}
            {%- if section.settings.image_mobile != blank -%}
              <img class="editorial-image__img editorial-image__img--mobile" src="{{ section.settings.image_mobile | image_url: width: 1200 }}" srcset="{{ section.settings.image_mobile | image_url: width: 750 }} 750w, {{ section.settings.image_mobile | image_url: width: 1200 }} 1200w" sizes="100vw" width="{{ section.settings.image_mobile.width }}" height="{{ section.settings.image_mobile.height }}" alt="{{ section.settings.image_mobile.alt | escape }}" loading="lazy">
            {%- endif -%}
            <img class="editorial-image__img editorial-image__img--desktop" src="{{ img | image_url: width: 2400 }}" srcset="{{ img | image_url: width: 1200 }} 1200w, {{ img | image_url: width: 1800 }} 1800w, {{ img | image_url: width: 2400 }} 2400w, {{ img | image_url: width: 3200 }} 3200w" sizes="100vw" width="{{ img.width }}" height="{{ img.height }}" alt="{{ img.alt | escape }}" loading="lazy">
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
      {%- endcapture -%}

      {%- capture caption -%}
        {%- if has_text -%}
          <figcaption class="editorial-image__caption">
            {%- if section.settings.eyebrow != blank -%}
              <p class="editorial-image__eyebrow tt-utility">{{ section.settings.eyebrow | escape }}</p>
            {%- endif -%}
            {%- if section.settings.heading != blank -%}
              {%- if section.settings.heading_style == 'drop' -%}
                <h2 class="editorial-image__heading tt-drop-title">{{ section.settings.heading }}</h2>
              {%- elsif section.settings.heading_style == 'label' -%}
                <h2 class="editorial-image__heading tt-section-heading">{{ section.settings.heading }}</h2>
              {%- else -%}
                <h2 class="editorial-image__heading tt-editorial-heading">{{ section.settings.heading }}</h2>
              {%- endif -%}
            {%- endif -%}
            {%- if section.settings.text != blank -%}
              <div class="editorial-image__text rte">{{ section.settings.text }}</div>
            {%- endif -%}
            {%- if section.settings.link_label != blank and section.settings.link_url != blank -%}
              <a class="editorial-image__link tt-nav" href="{{ section.settings.link_url }}">
                {{- section.settings.link_label | escape -}}
                <span aria-hidden="true">&rarr;</span>
              </a>
            {%- endif -%}
          </figcaption>
        {%- endif -%}
      {%- endcapture -%}

      {%- if is_overlay -%}
        {{ media }}{{ caption }}
      {%- elsif place == 'beside-left' -%}
        {{ caption }}{{ media }}
      {%- else -%}
        {{ media }}{{ caption }}
      {%- endif -%}
    </figure>
  </div>
</div>

{% schema %}
{
  "name": "Editorial Image",
  "tag": "section",
  "class": "section section--tt-module",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image (desktop)" },
    { "type": "image_picker", "id": "image_mobile", "label": "Image (mobile)" },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading" },
    {
      "type": "select",
      "id": "heading_style",
      "label": "Heading style",
      "options": [
        { "value": "editorial", "label": "Editorial" },
        { "value": "drop", "label": "Drop title" },
        { "value": "label", "label": "Utility label" }
      ],
      "default": "editorial"
    },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "url", "id": "link_url", "label": "Link URL" },
    {
      "type": "select",
      "id": "text_placement",
      "label": "Text placement",
      "options": [
        { "value": "below", "label": "Below image" },
        { "value": "beside-left", "label": "Beside image (left)" },
        { "value": "beside-right", "label": "Beside image (right)" },
        { "value": "overlay-bottom-left", "label": "Over image, bottom left" },
        { "value": "overlay-center", "label": "Over image, centered" }
      ],
      "default": "below"
    },
    {
      "type": "select",
      "id": "scrim",
      "label": "Image scrim",
      "info": "Only applies when text is over the image.",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "subtle", "label": "Subtle" },
        { "value": "strong", "label": "Strong" }
      ],
      "default": "subtle"
    },
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        { "value": "full", "label": "Full bleed" },
        { "value": "wide", "label": "Wide" },
        { "value": "constrained", "label": "Constrained" }
      ],
      "default": "wide"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "natural", "label": "Natural (uncropped)" },
        { "value": "landscape", "label": "Landscape" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "featured-wide", "label": "Wide" },
        { "value": "featured-tall", "label": "Tall" }
      ],
      "default": "natural"
    },
    { "type": "header", "content": "Section" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 64, "label": "Top padding" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 64, "label": "Bottom padding" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [
    { "name": "Editorial Image", "settings": { "width": "wide", "image_ratio": "natural", "text_placement": "below" } }
  ]
}
{% endschema %}
