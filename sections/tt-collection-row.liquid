{%- comment -%}
  Tootaloo — Collection Row. One flexible module that powers several
  homepage merchandising blocks via schema presets:

    Current Drop · Just In · Recently Sold · Archive Teaser · Vintage Module

  A heading + an optional row/grid of product cards drawn from one
  collection, plus a "view all" link. No imagery or copy is baked in;
  leave the collection empty and the module shows a quiet placeholder in
  the theme editor and nothing on the live site.
{%- endcomment -%}

{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'tt-modules.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign kind = section.settings.module_kind
  assign coll = section.settings.collection
  assign limit = section.settings.product_limit
  assign sold_on = false
  if section.settings.sold_treatment == 'on'
    assign sold_on = true
  elsif section.settings.sold_treatment == 'auto' and kind == 'recently_sold'
    assign sold_on = true
  elsif section.settings.sold_treatment == 'auto' and kind == 'archive_teaser'
    assign sold_on = true
  endif

  assign link_url = section.settings.link_url
  if link_url == blank and coll != blank
    assign link_url = coll.url
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --row-cols-desktop: {{ section.settings.columns_desktop }};
    --row-cols-mobile: {{ section.settings.columns_mobile }};
    --row-ratio: {{ section.settings.image_ratio }};
  }
  #shopify-section-{{ section.id }} .tt-collection-row {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .tt-collection-row {
      padding-top: {{ section.settings.padding_top | times: 0.6 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round }}px;
    }
  }
{%- endstyle -%}

<div class="tt-collection-row tt-collection-row--{{ kind }} tt-collection-row--span-{{ section.settings.span }} color-{{ section.settings.color_scheme }} gradient{% if sold_on %} tt-collection-row--sold{% endif %}">
  <div class="tt-collection-row__inner {% if section.settings.span == 'full' %}tt-fullbleed{% else %}page-width{% endif %}">
    {%- liquid
      assign is_carousel = false
      if section.settings.layout == 'scroller'
        assign is_carousel = true
      endif
      assign has_products = false
      if coll != blank and coll.products_count > 0
        assign has_products = true
      endif
    -%}

    {%- if is_carousel and has_products -%}
      <div class="tt-carousel" data-tt-carousel>
        <div class="tt-carousel__head">
          {%- render 'tt-module-header',
            eyebrow: section.settings.eyebrow,
            heading: section.settings.heading,
            heading_style: section.settings.heading_style,
            text: section.settings.text,
            link_label: section.settings.link_label,
            link_url: link_url,
            align: section.settings.align
          -%}
          <div class="tt-carousel__nav">
            <button type="button" class="tt-carousel__arrow tt-carousel__arrow--prev" data-tt-carousel-prev aria-label="{{ 'general.pagination.previous' | t | default: 'Previous' }}" disabled>
              {{- 'icon-tt-arrow.svg' | inline_asset_content -}}
            </button>
            <button type="button" class="tt-carousel__arrow tt-carousel__arrow--next" data-tt-carousel-next aria-label="{{ 'general.pagination.next' | t | default: 'Next' }}">
              {{- 'icon-tt-arrow.svg' | inline_asset_content -}}
            </button>
          </div>
        </div>
        {%- render 'tt-product-grid',
          collection: coll,
          limit: limit,
          layout: 'scroller',
          cols_desktop: section.settings.columns_desktop,
          cols_mobile: section.settings.columns_mobile,
          image_ratio: section.settings.image_ratio,
          sold_on: sold_on,
          section_id: section.id
        -%}
      </div>
      <script src="{{ 'tt-carousel.js' | asset_url }}" defer="defer"></script>
    {%- else -%}
      {%- render 'tt-module-header',
        eyebrow: section.settings.eyebrow,
        heading: section.settings.heading,
        heading_style: section.settings.heading_style,
        text: section.settings.text,
        link_label: section.settings.link_label,
        link_url: link_url,
        align: section.settings.align
      -%}

      {%- if has_products -%}
        {%- render 'tt-product-grid',
          collection: coll,
          limit: limit,
          layout: section.settings.layout,
          cols_desktop: section.settings.columns_desktop,
          cols_mobile: section.settings.columns_mobile,
          image_ratio: section.settings.image_ratio,
          sold_on: sold_on,
          section_id: section.id
        -%}
      {%- elsif request.design_mode -%}
        <p class="tt-collection-row__placeholder">
          Pick a collection in this section&rsquo;s settings. The module stays hidden on the live site until you do.
        </p>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Collection Row",
  "tag": "section",
  "class": "section section--tt-module",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "select",
      "id": "module_kind",
      "label": "Module type",
      "info": "Sets sensible defaults and sold-piece styling. Purely a behaviour hint — customise everything below.",
      "options": [
        { "value": "current_drop", "label": "Current Drop" },
        { "value": "just_in", "label": "Just In" },
        { "value": "recently_sold", "label": "Recently Sold" },
        { "value": "archive_teaser", "label": "Archive Teaser" },
        { "value": "vintage", "label": "Vintage Module" }
      ],
      "default": "current_drop"
    },
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading" },
    {
      "type": "select",
      "id": "heading_style",
      "label": "Heading style",
      "options": [
        { "value": "label", "label": "Utility label" },
        { "value": "editorial", "label": "Editorial" },
        { "value": "drop", "label": "Drop title" }
      ],
      "default": "label"
    },
    { "type": "richtext", "id": "text", "label": "Text" },
    {
      "type": "select",
      "id": "align",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    { "type": "header", "content": "Products" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "For Recently Sold, point this at a smart collection with the rule “Product tag is equal to sold”, sorted newest-first — it then tracks real sales." },
    {
      "type": "range",
      "id": "product_limit",
      "min": 2, "max": 24, "step": 1, "default": 8,
      "label": "Products to show"
    },
    { "type": "text", "id": "link_label", "label": "Link label", "info": "e.g. “View the drop”. Links to the collection unless a URL is set below." },
    { "type": "url", "id": "link_url", "label": "Link URL" },
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "scroller", "label": "Carousel (arrows on desktop, swipe on mobile)" }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2, "max": 6, "step": 1, "default": 4,
      "label": "Columns on desktop"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" },
        { "value": "landscape", "label": "Landscape" },
        { "value": "adapt", "label": "Natural" }
      ],
      "default": "portrait"
    },
    {
      "type": "select",
      "id": "span",
      "label": "Module width",
      "options": [
        { "value": "normal", "label": "Constrained" },
        { "value": "wide", "label": "Wide" },
        { "value": "full", "label": "Full bleed" }
      ],
      "default": "normal"
    },
    { "type": "header", "content": "Sold pieces" },
    {
      "type": "select",
      "id": "sold_treatment",
      "label": "Sold styling",
      "info": "Dims sold pieces and shows the month they sold (from the archive date metafield).",
      "options": [
        { "value": "auto", "label": "Automatic (on for Recently Sold / Archive)" },
        { "value": "on", "label": "Always on" },
        { "value": "off", "label": "Off" }
      ],
      "default": "auto"
    },
    { "type": "header", "content": "Section" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 160, "step": 8, "unit": "px", "default": 64,
      "label": "Top padding"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 160, "step": 8, "unit": "px", "default": 64,
      "label": "Bottom padding"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [
    {
      "name": "Current Drop",
      "settings": { "module_kind": "current_drop", "eyebrow": "Now", "heading": "Current Drop", "heading_style": "drop", "link_label": "View the drop", "product_limit": 4, "padding_top": 72, "padding_bottom": 72 }
    },
    {
      "name": "Just In",
      "settings": { "module_kind": "just_in", "heading": "Just In", "heading_style": "label", "link_label": "See everything new", "product_limit": 6, "layout": "scroller" }
    },
    {
      "name": "Recently Sold",
      "settings": { "module_kind": "recently_sold", "heading": "Recently Sold", "heading_style": "label", "sold_treatment": "auto", "product_limit": 4, "image_ratio": "portrait" }
    },
    {
      "name": "Archive Teaser",
      "settings": { "module_kind": "archive_teaser", "eyebrow": "Passed through", "heading": "The Archive", "heading_style": "editorial", "link_label": "Enter the archive", "sold_treatment": "auto", "product_limit": 4 }
    },
    {
      "name": "Vintage Module",
      "settings": { "module_kind": "vintage", "heading": "Vintage", "heading_style": "editorial", "link_label": "All vintage", "product_limit": 6, "span": "wide" }
    }
  ]
}
{% endschema %}
