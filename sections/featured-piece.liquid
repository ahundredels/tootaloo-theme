{%- comment -%}
  Tootaloo — Featured Piece. One product given a large, quiet moment:
  oversized image beside (or above) the vendor / name / price / link.
  Not Dawn's full "Featured product" section — no variant picker, no
  add-to-cart here; this sends people to the PDP.

  Leave the product empty and the section shows a placeholder in the
  theme editor, nothing on the live site.
{%- endcomment -%}

{{ 'tt-modules.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign product = section.settings.product
  assign heading = section.settings.heading | default: product.title
  assign img = product.featured_media
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .featured-piece {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .featured-piece {
      padding-top: {{ section.settings.padding_top | times: 0.6 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round }}px;
    }
  }
{%- endstyle -%}

<div class="featured-piece featured-piece--{{ section.settings.layout }} featured-piece--span-{{ section.settings.span }} color-{{ section.settings.color_scheme }} gradient">
  <div class="featured-piece__inner {% if section.settings.span == 'full' %}tt-fullbleed{% else %}page-width{% endif %}">
    {%- if product != blank -%}
      <a class="featured-piece__media tt-media" data-ratio="{{ section.settings.image_ratio }}" href="{{ product.url }}">
        {%- if img -%}
          {{
            img
            | image_url: width: 2000
            | image_tag:
              loading: 'lazy',
              widths: '400, 600, 900, 1200, 1600, 2000',
              sizes: '(min-width: 990px) 60vw, 100vw',
              alt: img.alt | default: product.title | escape
          }}
        {%- else -%}
          {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </a>

      <div class="featured-piece__info">
        {%- if section.settings.eyebrow != blank -%}
          <p class="featured-piece__eyebrow tt-utility">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.show_vendor and product.vendor != blank -%}
          <p class="featured-piece__vendor tt-vendor">{{ product.vendor | escape }}</p>
        {%- endif -%}
        <h2 class="featured-piece__heading tt-editorial-heading">
          <a href="{{ product.url }}">{{ heading }}</a>
        </h2>
        {%- if section.settings.text != blank -%}
          <div class="featured-piece__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.show_price -%}
          <p class="featured-piece__price tt-price">
            {%- render 'price', product: product, use_variant: true -%}
          </p>
        {%- endif -%}
        <a class="featured-piece__link tt-nav" href="{{ product.url }}">
          {{- section.settings.link_label | default: 'View piece' | escape -}}
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    {%- elsif request.design_mode -%}
      <p class="tt-collection-row__placeholder">Pick a product in this section&rsquo;s settings.</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Featured Piece",
  "tag": "section",
  "class": "section section--tt-module",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "info": "Defaults to the product name." },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": true },
    { "type": "checkbox", "id": "show_price", "label": "Show price", "default": true },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View piece" },
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "image-left", "label": "Image left" },
        { "value": "image-right", "label": "Image right" },
        { "value": "stacked", "label": "Image above text" }
      ],
      "default": "image-left"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" },
        { "value": "landscape", "label": "Landscape" },
        { "value": "featured-tall", "label": "Tall" }
      ],
      "default": "portrait"
    },
    {
      "type": "select",
      "id": "span",
      "label": "Section width",
      "options": [
        { "value": "normal", "label": "Constrained" },
        { "value": "wide", "label": "Wide" },
        { "value": "full", "label": "Full bleed" }
      ],
      "default": "wide"
    },
    { "type": "header", "content": "Section" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96, "label": "Top padding" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96, "label": "Bottom padding" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [
    { "name": "Featured Piece", "settings": { "layout": "image-left", "span": "wide", "link_label": "View piece" } }
  ]
}
{% endschema %}
