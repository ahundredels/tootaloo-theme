{% comment %}
  Hero Wordmark — the opening frame of the site: a full-bleed image with an
  oversized wordmark laid over it. Everything is a setting; no photography,
  copy or colour is baked in. Empty state shows a neutral placeholder.

  Theme editor > Home page > Add section > Hero Wordmark.
  Navigation lives in the header, not here.
{% endcomment %}

{%- liquid
  assign scrim = section.settings.scrim
  assign v_pos = section.settings.text_position_y
  assign h_pos = section.settings.text_position_x
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .hero-wordmark {
    --hero-height: {{ section.settings.height }}vh;
    --hero-align-y: {% if v_pos == 'top' %}flex-start{% elsif v_pos == 'center' %}center{% else %}flex-end{% endif %};
    --hero-align-x: {% if h_pos == 'left' %}flex-start{% elsif h_pos == 'center' %}center{% else %}flex-end{% endif %};
    --hero-text-align: {{ h_pos }};
    --hero-wordmark-size: var(--tt-fs-{{ section.settings.wordmark_size }});
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .hero-wordmark {
      --hero-height: {{ section.settings.height_mobile }}vh;
    }
  }
{%- endstyle -%}

<div class="hero-wordmark color-{{ section.settings.color_scheme }} gradient hero-wordmark--scrim-{{ scrim }}">
  <div class="hero-wordmark__media tt-media tt-media--natural">
    {%- if section.settings.image != blank -%}
      {%- if section.settings.image_mobile != blank -%}
        <img
          class="hero-wordmark__image hero-wordmark__image--mobile"
          src="{{ section.settings.image_mobile | image_url: width: 1200 }}"
          srcset="{{ section.settings.image_mobile | image_url: width: 750 }} 750w, {{ section.settings.image_mobile | image_url: width: 1200 }} 1200w"
          sizes="100vw"
          width="{{ section.settings.image_mobile.width }}"
          height="{{ section.settings.image_mobile.height }}"
          alt="{{ section.settings.image_mobile.alt | escape }}"
          loading="eager"
          fetchpriority="high"
        >
      {%- endif -%}
      <img
        class="hero-wordmark__image hero-wordmark__image--desktop"
        src="{{ section.settings.image | image_url: width: 2200 }}"
        srcset="
          {{ section.settings.image | image_url: width: 1200 }} 1200w,
          {{ section.settings.image | image_url: width: 1800 }} 1800w,
          {{ section.settings.image | image_url: width: 2200 }} 2200w,
          {{ section.settings.image | image_url: width: 3000 }} 3000w"
        sizes="100vw"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        alt="{{ section.settings.image.alt | escape }}"
        loading="eager"
        fetchpriority="high"
      >
    {%- else -%}
      <div class="hero-wordmark__placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {%- endif -%}
  </div>

  <div class="hero-wordmark__overlay">
    <div class="hero-wordmark__inner">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hero-wordmark__eyebrow tt-utility">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="hero-wordmark__title tt-wordmark">
        {{- section.settings.wordmark | default: shop.name | escape -}}
      </h1>
      {%- if section.settings.link_label != blank -%}
        <a class="hero-wordmark__link tt-nav" href="{{ section.settings.link | default: routes.all_products_collection_url }}">
          {{- section.settings.link_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .hero-wordmark {
    position: relative;
    width: 100%;
    min-height: var(--hero-height, 90vh);
    display: flex;
    overflow: hidden;
  }

  .hero-wordmark__media {
    position: absolute;
    inset: 0;
    background: rgba(var(--color-foreground), 0.04);
  }

  .hero-wordmark__image,
  .hero-wordmark__placeholder,
  .hero-wordmark__placeholder svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-wordmark__image--mobile { display: none; }

  @media screen and (max-width: 749px) {
    .hero-wordmark__image--desktop { display: none; }
    .hero-wordmark:has(.hero-wordmark__image--mobile) .hero-wordmark__image--mobile { display: block; }
  }

  .hero-wordmark--scrim-subtle .hero-wordmark__media::after,
  .hero-wordmark--scrim-strong .hero-wordmark__media::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, var(--hero-scrim-opacity, 0.4)),
      rgba(0, 0, 0, 0) 60%
    );
  }

  .hero-wordmark--scrim-strong { --hero-scrim-opacity: 0.62; }

  .hero-wordmark__overlay {
    position: relative;
    z-index: 1;
    display: flex;
    flex: 1;
    align-items: var(--hero-align-y, flex-end);
    justify-content: var(--hero-align-x, flex-start);
    padding: var(--tt-space-lg) var(--tt-gutter);
  }

  .hero-wordmark__inner {
    display: flex;
    flex-direction: column;
    gap: var(--tt-space-xs);
    text-align: var(--hero-text-align, left);
    align-items: var(--hero-align-x, flex-start);
    max-width: min(100%, var(--tt-content-wide));
  }

  .hero-wordmark__title {
    font-size: var(--hero-wordmark-size, var(--tt-fs-oversized));
    margin: 0;
    color: rgb(var(--color-foreground));
    mix-blend-mode: difference;
  }

  .hero-wordmark--scrim-subtle .hero-wordmark__title,
  .hero-wordmark--scrim-strong .hero-wordmark__title {
    mix-blend-mode: normal;
    color: #fff;
  }

  .hero-wordmark__eyebrow,
  .hero-wordmark__link {
    margin: 0;
    color: inherit;
  }

  .hero-wordmark--scrim-subtle .hero-wordmark__overlay,
  .hero-wordmark--scrim-strong .hero-wordmark__overlay { color: #fff; }

  .hero-wordmark__link {
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.2rem;
    align-self: var(--hero-align-x, flex-start);
  }

  @media screen and (max-width: 749px) {
    .hero-wordmark__overlay { padding: var(--tt-space-md) var(--tt-gutter); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero Wordmark",
  "tag": "section",
  "class": "section section--hero-wordmark",
  "settings": [
    {
      "type": "paragraph",
      "content": "Full-bleed opening frame. Leave the image empty to show a neutral placeholder — real photography drops in later with no code change."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image (desktop)"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Background image (mobile)",
      "info": "Optional. Falls back to the desktop image."
    },
    {
      "type": "header",
      "content": "Height"
    },
    {
      "type": "range",
      "id": "height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Desktop height",
      "default": 90
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Mobile height",
      "default": 80
    },
    {
      "type": "header",
      "content": "Wordmark"
    },
    {
      "type": "text",
      "id": "wordmark",
      "label": "Wordmark text",
      "info": "Leave blank to use the store name."
    },
    {
      "type": "select",
      "id": "wordmark_size",
      "label": "Wordmark size",
      "options": [
        { "value": "display", "label": "Large" },
        { "value": "oversized", "label": "Oversized" }
      ],
      "default": "oversized"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "info": "Small line above the wordmark. Optional."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "info": "Optional."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Placement"
    },
    {
      "type": "select",
      "id": "text_position_y",
      "label": "Vertical position",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "bottom"
    },
    {
      "type": "select",
      "id": "text_position_x",
      "label": "Horizontal position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "scrim",
      "label": "Image scrim",
      "info": "Darkens the lower image so text stays legible over photography.",
      "options": [
        { "value": "none", "label": "None (blend mode)" },
        { "value": "subtle", "label": "Subtle" },
        { "value": "strong", "label": "Strong" }
      ],
      "default": "none"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Hero Wordmark"
    }
  ]
}
{% endschema %}
